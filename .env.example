AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5-pro

# Optional isolated local OCR sidecar. Keep model files and tokens outside Git.
PADDLEOCR_VL_ENDPOINT=http://127.0.0.1:8765
PADDLEOCR_VL_TOKEN=replace-with-a-local-random-token
PADDLEOCR_VL_MODEL_DIR=C:\path\to\PaddleOCR-VL-1.6
PADDLEOCR_VL_DEVICE=gpu

# Optional server-only Hermes companion contract. Never expose HERMES_API_KEY
# to browser code or commit a populated value.
HERMES_RUNTIME_URL=
HERMES_MODEL=
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_SKILLS_ROOT=
# Local development only: let the Web Next server own Hermes process controls.
# Production Web deployments keep this disabled; Electron uses its own Supervisor.
HERMES_WEB_CONTROL_ENABLED=true
# When HERMES_BASE_URL/HERMES_MODEL are empty, the Hermes preflight may reuse
# the server-side AI_BASE_URL/AI_MODEL/AI_API_KEY values above.

# Optional local demo preflight. Never enables dependency updates or writes secrets.
ROADSHOW_AGENT_MODE=false
